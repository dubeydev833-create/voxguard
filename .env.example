# VoxGuard Backend Configuration Template
# Copy to .env for local development. Never commit real API keys or credentials.

# LLM Provider Configuration (Server-Side Only)
VOXGUARD_LLM_PROVIDER=mock

# External Provider API Keys (Optional - only required if using live external LLM)
# All keys remain strictly server-side and are NEVER exposed to clients.
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Server Host and Port
VOXGUARD_HOST=127.0.0.1
VOXGUARD_PORT=8000
